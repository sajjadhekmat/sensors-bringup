# VScom USB-CAN Plus (FTDI 0403:6015, serial D30IO864).
# Matches on the USB serial number, so any USB port works. On plug-in it
# starts slcan@<ttyUSBx>.service, which creates and brings up can0.
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6015", ENV{ID_SERIAL_SHORT}=="D30IO864", SYMLINK+="usbcan", TAG+="systemd", ENV{SYSTEMD_WANTS}+="slcan@%k.service"
